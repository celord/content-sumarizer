# Copy to .env and fill in. .env is git-ignored.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to use the bot (negative ids for groups).
ALLOWED_CHAT_IDS=

# Anthropic API key used for Analysis (the default provider).
ANTHROPIC_API_KEY=

# Optional: use an OpenAI-compatible API for Analysis instead of Anthropic.
# When LLM_BASE_URL is set, LLM_API_KEY is required and ANTHROPIC_API_KEY is not.
# Set LLM_MODEL to a model id from that provider.
#
# OpenRouter (free models end in ":free"):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=<model id>:free
#
# NVIDIA NIM (free key from build.nvidia.com, starts with "nvapi-"):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Tested 2026-11: nemotron-3.5-lightning passes (about 65 s per Note, it reasons first).
# meta/llama-3.3-70b-instruct is retired (410). Model access varies by account:
# list yours with GET https://integrate.api.nvidia.com/v1/models; a 404 on a listed
# model means your account can't use it.
LLM_BASE_URL=
LLM_API_KEY=

# Groq API key used for Whisper speech-to-text.
GROQ_API_KEY=

# Absolute host path of the Obsidian Vault. Mounted at the same path inside the container.
VAULT_PATH=

# Model used for Analysis.
LLM_MODEL=claude-haiku-5-5

# Folder inside the Vault where Notes are written.
NOTE_SUBFOLDER=Inbox/TikTok

# Language Notes are written in.
NOTE_LANGUAGE=English

# Videos longer than this many seconds are rejected.
MAX_DURATION_SECONDS=900
