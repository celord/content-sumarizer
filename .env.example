# Copy to .env and fill in. .env is git-ignored.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to use the bot (negative ids for groups).
ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# Analysis model. Pick ONE option and set LLM_MODEL to match.
# ---------------------------------------------------------------------------
# A) Anthropic (default, paid, cheapest Claude): set ANTHROPIC_API_KEY,
#    leave LLM_BASE_URL empty, LLM_MODEL=claude-haiku-5-5
#
# B) NVIDIA NIM (free key from build.nvidia.com, starts with "nvapi-"):
#    LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#    LLM_API_KEY=nvapi-...
#    LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#    Tested 2026-11: about 65 s per Note. meta/llama-3.3-70b-instruct is retired (410).
#    Model access varies by account: GET https://integrate.api.nvidia.com/v1/models;
#    a 404 on a listed model means your account can't use it.
#
# C) OpenRouter (free models end in ":free"):
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_API_KEY=sk-or-...
#    LLM_MODEL=<model id>:free
#
# D) Local Ollama on your GPU (free, needs: docker compose --profile local up -d):
#    LLM_BASE_URL=http://ollama:11434/v1
#    LLM_API_KEY=            (not needed)
#    LLM_MODEL=qwen3:8b      (fits 12 GB VRAM next to Whisper)
#    Download the model once: docker compose exec ollama ollama pull qwen3:8b
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Speech-to-text, used when a TikTok has no subtitles. Pick ONE option.
# ---------------------------------------------------------------------------
# A) Groq Whisper API (default, free tier): set GROQ_API_KEY, leave STT_BASE_URL empty.
#
# B) Local Whisper on your GPU (free, needs: docker compose --profile local up -d):
#    STT_BASE_URL=http://whisper:8000/v1
#    STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
#    GROQ_API_KEY=           (not needed)
#    Download the model once (about 1.6 GB, kept in the hf-cache volume):
#    docker compose exec whisper curl -X POST http://localhost:8000/v1/models/deepdml/faster-whisper-large-v3-turbo-ct2
GROQ_API_KEY=
STT_BASE_URL=
STT_MODEL=

# Absolute host path of the Obsidian Vault. Mounted at the same path inside the container.
VAULT_PATH=

# Folder inside the Vault where Notes are written.
NOTE_SUBFOLDER=Inbox/TikTok

# Language Notes are written in.
NOTE_LANGUAGE=English

# Videos longer than this many seconds are rejected.
MAX_DURATION_SECONDS=900
